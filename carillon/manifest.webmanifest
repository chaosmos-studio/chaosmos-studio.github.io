{"name":"Carillon","short_name":"Carillon","description":"Carillon is a calm chain-reaction puzzle: tap a dot, its ring pops its neighbours, and every pop is a note. Clear each field in few taps. Free on Android.","start_url":"/carillon/","scope":"/carillon/","display":"standalone","background_color":"#eef1fb","theme_color":"#eef1fb","icons":[{"src":"/carillon/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/carillon/icon-512.png","sizes":"512x512","type":"image/png"}]}